{
  "Database": {
    "ConnectionId": "AspireDb"
  },
  "Artifacts": {
    "BasePath": "artifacts",
    "Database": {
      "ConnectionId": "AspireDb"
    }
  },
  "Worker": {
    "ContainerTimeZone": "Etc/UTC"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],

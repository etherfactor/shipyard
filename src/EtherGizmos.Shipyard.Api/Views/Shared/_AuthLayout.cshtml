@*
  Views/Shared/_Layout.cshtml
  Basic layout for Login/Consent pages (and anything else).
*@
@{
  var appName = (string?)ViewData["AppName"] ?? "Auth Server";
  var title = (string?)ViewData["Title"] ?? appName;
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@title - @appName</title>

  <link rel="stylesheet" href="~/css/styles.scss" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
  <main class="min-vh-100 d-flex align-items-center justify-content-center">
    <div class="card shadow-sm" style="max-width: 460px; width: 100%;">
      <div class="card-body p-4">
        @RenderBody()
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>

  @RenderSection("Scripts", required: false)
</body>
</html>

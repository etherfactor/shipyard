@model ChangePasswordViewModel
@{
  Layout = "_AuthLayout";
  ViewData["Title"] = "Change Password";
}

<!-- Brand -->
<div class="box-title d-flex align-items-center gap-3 pb-4 mb-4">
  <div class="rounded-circle d-flex align-items-center justify-content-center"
       style="width: 48px; height: 48px; background: rgba(13, 110, 253, .12);">
    <i class="bi bi-box-seam-fill fs-4 text-primary" aria-hidden="true"></i>
  </div>
  <div>
    <h1 class="h4 mb-0">Shipyard</h1>
    <div class="text-secondary small">Sign in to continue</div>
  </div>
</div>

<form asp-action="ChangePasswordPost" asp-controller="InternalAuthentication" method="post">
  @Html.AntiForgeryToken()

  <input type="hidden" asp-for="ReturnUrl" />

  <div class="validation-summary" asp-validation-summary="ModelOnly"></div>

  <div class="floating-label mt-3">
    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" placeholder=" " />
    <label asp-for="CurrentPassword">Current password</label>
    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
  </div>

  <div class="floating-label mt-3">
    <input asp-for="NewPassword" class="form-control" placeholder=" " />
    <label asp-for="NewPassword">New password</label>
    <span asp-validation-for="NewPassword" class="text-danger"></span>
  </div>

  <div class="floating-label mt-3">
    <input asp-for="ConfirmPassword" class="form-control" autocomplete="current-password" placeholder=" " />
    <label asp-for="ConfirmPassword">Confirm password</label>
    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
  </div>

  <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
    <i class="bi bi-key" aria-hidden="true"></i>
    <span>Change password</span>
  </button>
</form>

@model LoginViewModel
@{
  Layout = "_AuthLayout";
  ViewData["Title"] = "Sign in";
}

<h3 style="text-align: center;">Sign in to Shipyard</h3>

<form asp-action="Login" asp-controller="InternalAuthentication" method="post">
  @Html.AntiForgeryToken()

  <input type="hidden" asp-for="ReturnUrl" />

  <div class="validation-summary" asp-validation-summary="ModelOnly"></div>

  <div class="floating-label mt-3">
    <input asp-for="Username" class="form-control" autocomplete="username" placeholder=" " />
    <label asp-for="Username"></label>
    <span asp-validation-for="Username" class="text-danger"></span>
  </div>

  <div class="floating-label mt-3">
    <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder=" " />
    <label asp-for="Password"></label>
    <span asp-validation-for="Password" class="text-danger"></span>
  </div>

  <button type="submit" class="btn btn-primary w-100 mt-3">Sign in</button>
</form>

@model LoginViewModel
@{
  Layout = "_AuthLayout";
  ViewData["Title"] = "Sign in";
}

<!-- Brand -->
<div class="box-title d-flex align-items-center gap-3 pb-4 mb-4">
  <div class="rounded-circle d-flex align-items-center justify-content-center"
       style="width: 48px; height: 48px; background: rgba(13, 110, 253, .12);">
    <i class="bi bi-box-seam-fill fs-4 text-primary" aria-hidden="true"></i>
  </div>
  <div>
    <h1 class="h4 mb-0">Shipyard</h1>
    <div class="text-secondary small">Sign in to continue</div>
  </div>
</div>

<form asp-action="Login" asp-controller="InternalAuthentication" method="post">
  @Html.AntiForgeryToken()

  <input type="hidden" asp-for="ReturnUrl" />

  <div class="validation-summary" asp-validation-summary="ModelOnly"></div>

  <div class="floating-label mt-3">
    <input asp-for="Username" class="form-control" autocomplete="username" placeholder=" " />
    <label asp-for="Username"></label>
    <span asp-validation-for="Username" class="text-danger"></span>
  </div>

  <div class="floating-label mt-3">
    <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder=" " />
    <label asp-for="Password"></label>
    <span asp-validation-for="Password" class="text-danger"></span>
  </div>

  <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
    <span>Sign in</span>
  </button>
</form>
